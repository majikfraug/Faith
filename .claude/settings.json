{
  "permissions": {
    "allow": [
      "Bash(python ad.py:*)",
      "Bash(python3 ad.py:*)",
      "Bash(py ad.py:*)",
      "Bash(.venv/bin/python ad.py:*)",
      "Bash(.venv/Scripts/python.exe ad.py:*)",
      "Bash(.venv/Scripts/python ad.py:*)",
      "Bash(python -m unittest:*)",
      "Bash(ffprobe:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "py .claude/hooks/timelog.py", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "py .claude/hooks/timelog.py", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "py .claude/hooks/timelog.py", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "py .claude/hooks/timelog.py", "timeout": 10 } ] }
    ]
  }
}
